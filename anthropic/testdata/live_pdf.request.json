{
  "model": "claude-sonnet-5",
  "max_tokens": 2048,
  "cache_control": {
    "type": "ephemeral"
  },
  "stream": true,
  "messages": [
    {
      "role": "user",
      "content": [
        {
          "type": "document",
          "source": {
            "type": "base64",
            "media_type": "application/pdf",
            "data": ""
          },
          "title": "A one-line document"
        },
        {
          "type": "text",
          "text": "Reply with the single line of text in this document, exactly, and nothing else."
        }
      ]
    }
  ]
}
