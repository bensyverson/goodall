{
  "model": "anthropic/claude-opus-5",
  "messages": [
    {
      "role": "user",
      "content": [
        {
          "type": "file",
          "file": {
            "filename": "A one-line document",
            "file_data": "data:application/pdf;base64,"
          }
        },
        {
          "type": "text",
          "text": "Reply with the single line of text in this document, exactly, and nothing else."
        }
      ]
    }
  ],
  "max_tokens": 2048,
  "stream": true,
  "cache_control": {
    "type": "ephemeral"
  },
  "plugins": [
    {
      "id": "file-parser",
      "pdf": {
        "engine": "native"
      }
    }
  ]
}
