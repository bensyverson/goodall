#!/usr/bin/env bash
# The pre-commit gate. Install once per clone with:
#   git config core.hooksPath scripts/git-hooks
# It runs the OFFLINE suite (-short): the live-provider tests spend real
# tokens and belong to a deliberate `go test ./...`, not to every commit.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

echo "==> go vet"
go vet ./...

echo "==> go fix"
# `go fix` can rewrite files in place without printing anything, so its
# output is not the signal: compare the worktree against the staged set.
# A file this commit includes that `go fix` changed is a hard fail with a
# re-stage hint, because a hook that re-staged it would commit code the
# author never read.
go fix ./... > /dev/null
staged=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -n "$staged" ]; then
  modified=$(git diff --name-only -- $staged)
  if [ -n "$modified" ]; then
    echo "go fix modified staged files:"
    echo "$modified"
    echo ""
    echo "Re-stage and commit again:"
    echo "  git add $(echo $modified | tr '\n' ' ') && git commit ..."
    exit 1
  fi
fi

echo "==> gofmt"
# Tracked files only: a walk of the tree would descend into
# .claude/worktrees/ and fail this commit on a parallel agent's half-written
# file (project/gotchas.md, 2026-09-15).
unformatted=$(git ls-files '*.go' | xargs gofmt -l)
if [ -n "$unformatted" ]; then
  echo "gofmt needs to format these files:"
  echo "$unformatted"
  echo ""
  echo "Run: gofmt -l -w \$(git ls-files '*.go')"
  exit 1
fi

echo "==> go mod tidy"
go mod tidy
# The `--` makes go.sum a pathspec, so its absence (zero dependencies) is
# not an error that reads as "changed".
if ! git diff --quiet -- go.mod go.sum; then
  echo "go.mod or go.sum changed after go mod tidy"
  echo "Run: go mod tidy && git add go.mod go.sum"
  exit 1
fi

echo "==> go test -short -race"
go test -short -race ./...

echo "==> go build"
go build ./...

# Shared agent rules: refuse a commit that leaves AGENTS.md or a generated
# project/agents/ file stale or hand-edited. `agents` is built from ~/git/agents.
echo "==> agents check"
if command -v agents > /dev/null; then
  agents check || exit 1
else
  echo "agents is not installed (go install from ~/git/agents); skipping"
fi

echo ""
echo "All checks passed."
