<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.bensyverson.goodall.drift-check</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/ben/git/goodall/scripts/drift-check/run.sh</string>
	</array>
	<!-- Mondays at 09:00. A run missed while the Mac slept happens on wake. -->
	<key>StartCalendarInterval</key>
	<dict>
		<key>Weekday</key>
		<integer>1</integer>
		<key>Hour</key>
		<integer>9</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
</dict>
</plist>
